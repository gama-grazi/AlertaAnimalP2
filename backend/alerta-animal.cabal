cabal-version: 3.0
name: alerta-animal
version: 0.1.0.0
build-type: Simple

executable alerta-animal
    main-is: Main.hs
    hs-source-dirs: app

    other-modules:
        Database
        Models
        Queries
        Handler
        Monitoramento
        Filtros

    default-language: Haskell2010

    default-extensions:
        DataKinds
        TypeOperators
        OverloadedStrings
        DeriveGeneric

    build-depends:
        base >=4.18 && <5,
        aeson,
        servant,
        servant-server,
        wai,
        warp,
        wai-middleware-static,
        sqlite-simple,
        text,
        time,
        bytestring,
        transformers

    ghc-options: -Wall -threaded -rtsopts
